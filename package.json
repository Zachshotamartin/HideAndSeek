    "train": "node scripts/train.mjs",
    "test:browser": "node scripts/browser-test.mjs",
    "capture": "node scripts/capture.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "vite": "^8.2.1"
  },
  "dependencies": {
    "three": "^0.180.0"
  }
